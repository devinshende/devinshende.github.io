---
const pageTitle = "Home";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<!-- Navbar -->
		<nav
			class="navbar has-shadow is-white"
			role="navigation"
			aria-label="main navigation"
		>
			<div class="container">
				<div class="navbar-brand">
					<a
						class="navbar-item has-text-link has-text-weight-bold"
						href="/">Devin Shende</a
					>
				</div>
				<div class="navbar-menu is-active">
					<div class="navbar-end">
						<a class="navbar-item has-text-link is-active" href="/"
							>Home</a
						>
						<a class="navbar-item has-text-link" href="/projects"
							>Projects</a
						>
						<a class="navbar-item has-text-link" href="/resume"
							>Resume</a
						>
					</div>
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="hero is-dark" style="padding-bottom: 0;">
			<div class="hero-body" style="padding-bottom: 0;">
				<div class="container" style="padding-bottom: 0;">
					<div class="columns is-vcentered">
						<!-- Left Column: Text -->
						<div class="column is-half">
							<h3 class="subtitle is-4 has-text-grey-light">
								HI! I AM
							</h3>
							<h1 class="title is-1 has-text-weight-bold">
								Devin Shende
							</h1>
							<h3 class="subtitle is-5 has-text-grey-lighter">
								I'm a NLP Master's Student at UCSC
							</h3>
						</div>

						<!-- Right Column: Image -->
						<!-- Right Column: Image -->
						<div class="column is-half has-text-centered">
							<!-- IMAGE GOES HERE -->
							<!-- <figure class="image is-inline-block">
								<img
									src="/devin.jpg"
									alt="Devin Shende"
									class="avatar"
								/>
							</figure> -->
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Main Content -->

		<section class="section" style="padding-top: 0;">
			<div class="container content" style="padding-top: 0;">
				<h1 class="title is-1 has-text-weight-bold">About Me</h1>

				<aside class="message is-info">
					<div class="message-body">
						I'm a 1st year M.S. Student at the University of
						California Santa Cruz studying Natural Language
						Processing.
						<br /><br />
						I received my Bachelor of Science from UCSC with a major in
						Computer Science and a minor in Spanish Studies. During my
						undergrad, I served as Head Climbing Coach for two years in
						the nonprofit Santa Cruz Climbs
						<br /><br />
						My research interests are related to applying Natural Language
						Processing techniques to solve environmental challenges such
						as conservation, climate change, and energy efficient systems.
						I love programming, rock climbing, slacklining and spending
						time outdoors.
					</div>
				</aside>

				<!-- Contact Section -->
				<h2 class="title is-3 has-text-link mt-6">Contact</h2>
				<p>
					<strong>Email:</strong>
					<a
						href="mailto:devin.s.shende@gmail.com"
						class="has-text-link">devin.s.shende@gmail.com</a
					>
				</p>
				<p>
					<strong>LinkedIn:</strong>
					<a
						href="https://www.linkedin.com/in/devin-shende-a66506367/"
						class="has-text-link">My LinkedIn</a
					>
				</p>
				<p>
					<strong>GitHub:</strong>
					<a
						href="https://github.com/devinshende"
						class="has-text-link">My GitHub</a
					>
				</p>
			</div>
		</section>
	</body>
</html>
