---
const pageTitle = "Projects";

import "../styles/global.css";

// Expanded project list with metadata, dates and stack
const projects = [
    {
        title: "EventMap",
        icon: "/appstore.png",
        dates: "Jun 2024 – Present",
        stack: "Flutter",
        description:
            "I co-founded EventMap and served as lead frontend developer on a four-person team building a mobile app to discover ongoing events across campus. We incorporated EventMap LLC, filed a patent, and published the app on the Apple App Store. I led the Flutter implementation, feature planning, and user testing, building geolocation-based discovery and RSVP flows to help students find activities quickly.",
        link: "https://eventmapllc.github.io",
    },
    {
        title: "Hurricane Damage",
        icon: "/katrina.jpg",
        dates: "Oct 2024 – Dec 2024",
        stack: "Python, Keras",
        description:
            "On a five-person research team I worked to improve damage classification in satellite imagery after Hurricane Katrina. I designed and trained CNN, ResNet, and ViT models for before-and-after binary classification, augmented the original Kaggle dataset with additional imagery and auxiliary data, and experimented with ensemble techniques to raise robustness and accuracy.",
        link: "https://github.com/devinshende/HurricanePredictionML",
    },
    {
        title: "NewSense",
        icon: "/nlp.png",
        dates: "Nov 2025",
        stack: "PyTorch, spaCy, FastAPI, GSAP",
        description:
            "NewSense won First Place in the UCSC NLP Dumbathon. We rapidly built a playful full-stack prototype that combined the Gemini API for text transformation with LLaMA for keyword-based redaction. I helped ship the interactive frontend with GSAP animations and a FastAPI backend that handled inference and streaming responses, producing a project that appealed to both technical and non-technical judges.",
        link: "https://github.com/devinshende/NewSense",
    },
    {
        title: "SemEval",
        icon: "/nlp.png",
        dates: "2026",
        stack: "NLP, Machine Learning",
        description:
            "On the SemEval task, I worked on culturally relevant question answering across multiple languages, building and evaluating NLP models for cross-lingual performance and cultural context sensitivity. I documented the approach, experiments, and final benchmark results in the project report.",
        link: "/semeval.pdf",
    },
];

---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <!-- Navbar -->
        <nav
            class="navbar has-shadow is-white"
            role="navigation"
            aria-label="main navigation"
        >
            <div class="container">
                <div class="navbar-brand">
                    <a
                        class="navbar-item has-text-link has-text-weight-bold"
                        href="/">Devin Shende</a
                    >
                </div>
                <div class="navbar-menu is-active">
                    <div class="navbar-end">
                        <a class="navbar-item has-text-link" href="/">Home</a>
                        <a
                            class="navbar-item has-text-link is-active"
                            href="/projects">Projects</a
                        >
                        <a class="navbar-item has-text-link" href="/resume"
                            >Resume</a
                        >
                    </div>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <section class="hero is-dark is-medium" style="padding-bottom: 0;">
            <div class="hero-body" style="padding-bottom: 0;">
                <div
                    class="container has-text-centered"
                    style="padding-bottom: 0;"
                >
                    <h1 class="title is-1 has-text-weight-bold">Projects</h1>
                    <h2 class="subtitle is-4 has-text-grey-lighter">
                        Some of my work and experiments
                    </h2>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section class="section" style="padding-top: 0;">
            <div class="container" style="padding-top: 0;">
                <div class="projects-list">
                    {
                        projects.map((p) => (
                            <article class="card">
                                <div class="card-content">
                                    <div class="project-row">
                                        {p.icon ? (
                                            <img
                                                src={p.icon}
                                                alt={`${p.title} icon`}
                                                class="project-icon"
                                            />
                                        ) : null}
                                        <div class="project-body">
                                            <h3 class="project-title">
                                                {p.title}
                                            </h3>
                                            <div class="project-meta">
                                                <span class="project-dates">
                                                    {p.dates}
                                                </span>
                                            </div>
                                            <div class="project-tags">
                                                {p.stack &&
                                                    p.stack
                                                        .split(",")
                                                        .map((s) => (
                                                            <span class="tag">
                                                                {s.trim()}
                                                            </span>
                                                        ))}
                                            </div>
                                            <p class="project-description">
                                                {p.description}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                {p.link && (
                                    <div class="card-footer">
                                        <a href={p.link} class="button">
                                            View Project
                                        </a>
                                    </div>
                                )}
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>
    </body>
</html>
